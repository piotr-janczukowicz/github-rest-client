<settings>
  <servers>
    <server>
      <id>central</id>
      <username>${env.CENTRAL_USERNAME}</username>
      <password>${env.CENTRAL_PASSWORD}</password>
    </server>
    <server>
      <id>github</id>
      <username>${env.GITHUB_ACTOR}</username>
      <password>${env.GITHUB_TOKEN}</password>
    </server>
    <server>
      <id>github-common-parent</id>
      <username>${env.GITHUB_ACTOR}</username>
      <password>${env.PACKAGES_TOKEN}</password>
    </server>
    <server>
      <id>github-common-util</id>
      <username>${env.GITHUB_ACTOR}</username>
      <password>${env.PACKAGES_TOKEN}</password>
    </server>
    <server>
      <id>github-common-json</id>
      <username>${env.GITHUB_ACTOR}</username>
      <password>${env.PACKAGES_TOKEN}</password>
    </server>
    <server>
      <id>github-common-http</id>
      <username>${env.GITHUB_ACTOR}</username>
      <password>${env.PACKAGES_TOKEN}</password>
    </server>
    <server>
      <id>github-common-test-support</id>
      <username>${env.GITHUB_ACTOR}</username>
      <password>${env.PACKAGES_TOKEN}</password>
    </server>
  </servers>
  <profiles>
    <profile>
      <id>github</id>
      <repositories>
        <repository>
          <id>github-common-parent</id>
          <url>https://maven.pkg.github.com/piotr-janczukowicz/common-parent</url>
          <snapshots>
            <enabled>false</enabled>
          </snapshots>
        </repository>
        <repository>
          <id>github-common-util</id>
          <url>https://maven.pkg.github.com/piotr-janczukowicz/common-util</url>
          <snapshots>
            <enabled>false</enabled>
          </snapshots>
        </repository>
        <repository>
          <id>github-common-json</id>
          <url>https://maven.pkg.github.com/piotr-janczukowicz/common-json</url>
          <snapshots>
            <enabled>false</enabled>
          </snapshots>
        </repository>
        <repository>
          <id>github-common-http</id>
          <url>https://maven.pkg.github.com/piotr-janczukowicz/common-http</url>
          <snapshots>
            <enabled>false</enabled>
          </snapshots>
        </repository>
        <repository>
          <id>github-common-test-support</id>
          <url>https://maven.pkg.github.com/piotr-janczukowicz/common-test-support</url>
          <snapshots>
            <enabled>false</enabled>
          </snapshots>
        </repository>
      </repositories>
      <pluginRepositories>
        <pluginRepository>
          <id>github-common-parent</id>
          <url>https://maven.pkg.github.com/piotr-janczukowicz/common-parent</url>
          <snapshots>
            <enabled>false</enabled>
          </snapshots>
        </pluginRepository>
      </pluginRepositories>
    </profile>
  </profiles>
  <activeProfiles>
    <activeProfile>github</activeProfile>
  </activeProfiles>
</settings>

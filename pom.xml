<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.piotr-janczukowicz</groupId>
    <artifactId>common-parent</artifactId>
    <version>11</version>
    <relativePath/>
  </parent>

  <artifactId>github-rest-client</artifactId>
  <version>2026.3.10.0-SNAPSHOT</version>
  <packaging>jar</packaging>

  <name>github-rest-client</name>
  <description>Java client for the GitHub REST API</description>
  <url>https://github.com/piotr-janczukowicz/github-rest-client</url>

  <properties>
    <common-util.version>8</common-util.version>
    <common-json.version>6</common-json.version>
    <common-http.version>4</common-http.version>
    <common-test-support.version>3</common-test-support.version>
    <test.module.args>--add-modules jdk.httpserver --add-reads io.github.piotr_janczukowicz.githubrestclient=jdk.httpserver --add-opens io.github.piotr_janczukowicz.githubrestclient/io.github.piotr_janczukowicz.test.support=common.util --add-opens io.github.piotr_janczukowicz.githubrestclient/io.github.piotr_janczukowicz.test=ALL-UNNAMED</test.module.args>
  </properties>

  <dependencies>
    <dependency>
      <groupId>io.github.piotr-janczukowicz</groupId>
      <artifactId>common-util</artifactId>
      <version>${common-util.version}</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>io.github.piotr-janczukowicz</groupId>
      <artifactId>common-json</artifactId>
      <version>${common-json.version}</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>io.github.piotr-janczukowicz</groupId>
      <artifactId>common-http</artifactId>
      <version>${common-http.version}</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>tools.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>com.squareup.okhttp3</groupId>
      <artifactId>okhttp-jvm</artifactId>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>io.soabase.record-builder</groupId>
      <artifactId>record-builder-core</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>io.github.piotr-janczukowicz</groupId>
      <artifactId>common-http</artifactId>
      <version>${common-http.version}</version>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.github.piotr-janczukowicz</groupId>
      <artifactId>common-test-support</artifactId>
      <version>${common-test-support.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.wiremock</groupId>
      <artifactId>wiremock</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.github.hakky54</groupId>
      <artifactId>logcaptor</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.networknt</groupId>
      <artifactId>json-schema-validator</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <executions>
          <execution>
            <id>default-testCompile</id>
            <configuration>
              <compilerArgs>
                <arg>--add-modules</arg>
                <arg>jdk.httpserver</arg>
                <arg>--add-reads</arg>
                <arg>io.github.piotr_janczukowicz.githubrestclient=jdk.httpserver</arg>
              </compilerArgs>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <groups>unit</groups>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <configuration>
          <groups>integration</groups>
          <includes>
            <include>**/*Test.java</include>
            <include>**/*IT.java</include>
            <include>**/*ITCase.java</include>
          </includes>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>catalog</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-surefire-plugin</artifactId>
            <configuration>
              <groups combine.self="override">catalog</groups>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>smoke</id>
      <properties>
        <jacoco.skip>true</jacoco.skip>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-failsafe-plugin</artifactId>
            <configuration>
              <groups combine.self="override">smoke</groups>
              <includes combine.children="override">
                <include>**/smoke/*SmokeIT.java</include>
              </includes>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>

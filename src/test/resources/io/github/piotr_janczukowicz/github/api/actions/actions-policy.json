{
  "id": 1,
  "name": "Restrict workflow modifications",
  "target": "actions",
  "source_type": "Enterprise",
  "source": "enterprise",
  "enforcement": "active",
  "conditions": {
    "organization_name": {
      "include": [
        "octo-org"
      ],
      "exclude": [
        "octo-org-archive"
      ]
    },
    "repository_name": {
      "include": [
        "Hello-World"
      ],
      "exclude": [
        "secret-*"
      ],
      "protected": false
    },
    "workflow_path": {
      "include": [
        ".github/workflows/ci.yml"
      ],
      "exclude": [
        ".github/workflows/legacy.yml"
      ]
    }
  },
  "rules": [
    {
      "type": "restrict_actions_actors",
      "parameters": {
        "allowed_actors": [
          {
            "id": 1234,
            "type": "Team"
          }
        ]
      }
    },
    {
      "type": "restrict_action_events",
      "parameters": {
        "allowed_events": [
          "push",
          "pull_request"
        ]
      }
    }
  ],
  "node_id": "RUL_lA",
  "_links": {
    "self": {
      "href": "https://api.github.com/enterprises/enterprise/actions/policies/1"
    },
    "html": {
      "href": "https://github.com/enterprises/enterprise/settings/policies/actions/1"
    }
  },
  "created_at": "2024-01-15T10:30:00Z",
  "updated_at": "2024-01-15T11:00:00Z"
}

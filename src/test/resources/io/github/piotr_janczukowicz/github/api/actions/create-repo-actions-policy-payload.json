{
  "name": "Require approved actors",
  "enforcement": "active",
  "conditions": {
    "workflow_path": {
      "include": [
        ".github/workflows/ci.yml"
      ],
      "exclude": [
        ".github/workflows/legacy.yml"
      ]
    }
  },
  "rules": [
    {
      "type": "restrict_actions_actors",
      "parameters": {
        "allowed_actors": [
          {
            "id": 1234,
            "type": "Team"
          }
        ]
      }
    }
  ]
}

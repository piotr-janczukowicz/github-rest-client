{
  "organization_property": {
    "include": [
      {
        "name": "tier",
        "property_values": [
          "gold"
        ]
      }
    ],
    "exclude": [
      {
        "name": "status",
        "property_values": [
          "archived"
        ]
      }
    ]
  },
  "repository_name": {
    "include": [
      "Hello-World"
    ],
    "exclude": [
      "secret-*"
    ],
    "protected": false
  },
  "ref_name": {
    "include": [
      "refs/heads/main"
    ],
    "exclude": [
      "refs/heads/dev*"
    ]
  }
}
